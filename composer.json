{
  "name": "bluecadet/bc_api_base",
  "description": "Base layer for all API implementations.",
  "type": "custom-drupal-module",
  "authors": [
    {
      "name": "Pete Inge",
      "email": "pete.inge@gmail.com",
      "role": "Maintainer"
    }
  ],
  "license": "GPL-2.0+",
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2||^8.3||^8.4",
    "bluecadet/bc_drupal_package_manager": "^1.1",
    "composer/installers": "^1.9||^2.0",
    "drupal/core": "^10||^11",
    "drupal/key_auth": "^1.0||^2.0",
    "oomphinc/composer-installers-extender": "^2.0"
  },
  "require-dev": {
    "drupal/crop": "^2.6",
    "drupal/focal_point": "^2.1"
  },
  "suggest": {
    "drupal/crop": "Required for ImageApiService to include focal-point crop data in image API responses.",
    "drupal/focal_point": "Required for ImageApiService to include focal-point crop data in image API responses."
  },
  "extra": {
    "bluecadet-package-manager": {
      "minimum_supported": [
        "3.1.0"
      ],
      "recommended": [
        "3.1.0"
      ]
    }
  }
}
